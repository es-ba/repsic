{
  "name": "repsic262",
  "description": "Relevamiento de personas en situación de calle",
  "version": "1.0.0",
  "private": true,
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "main": "dist/server/server-repsic.js",
  "types": "dist/server/app-repsic.d.ts",
  "files": [
    "dist",
    "install",
    "unlogged",
    "ayuda"
  ],
  "dependencies": {
    "cast-error": "^0.1.5",
    "cookie-parser": "^1.4.7",
    "dmencu": "^3.4.0",
    "guijarro": "^0.3.1",
    "yazl": "~2.5.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.19.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.3.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@types/react-redux": "^7.1.34",
    "@types/yazl": "~2.4.2",
    "discrepances": "~0.2.8",
    "js-yaml": "^5.4.3",
    "mixin-patch": "~0.4.1",
    "mocha": "^12.0.3",
    "pg-triggers": "~0.3.2",
    "types.d.ts": "~0.6.15",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">= 16.14.0"
  },
  "scripts": {
    "prepublish": "npm run build",
    "build": "tsc -p src/unlogged && tsc -p src/client && tsc -p src/server && mixin-patch",
    "build-client": "tsc -p src/client && tsc -p src/unlogged && mixin-patch",
    "build-unlogged": "tsc -p src/unlogged && mixin-patch",
    "build-server": "tsc -p src/server && mixin-patch",
    "mixin-patch": "mixin-patch",
    "watch:buildC": "tsc -p src/client --watch",
    "watch:buildS": "tsc -p src/server --watch",
    "watch:buildU": "tsc -p src/unlogged --watch",
    "test": "tsc -p src/test && mocha --reporter spec --bail --check-leaks dist/test/test.js",
    "start": "node dist/server/server-repsic.js",
    "dump": "npm start -- --dump-db",
    "bdump": "npm run build && npm run dump"
  },
  "config": {
    "stackFolder": "../../codenautas"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "app",
    "ecmaVersion": 6
  }
}
